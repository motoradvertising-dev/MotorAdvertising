@@ -0,0 +1,194 @@
+var httpNative   = require('http'),
+    httpsNative  = require('https'),
+    web_o  = require('./web-outgoing'),
+    common = require('../common'),
+    followRedirects = require('follow-redirects');
+
+web_o = Object.keys(web_o).map(function(pass) {
+  return web_o[pass];
