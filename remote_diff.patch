+'use strict';
+
+module.exports = function permsToString(stat) {
+  if (!stat.isDirectory || !stat.mode) {
+    return '???!!!???';
+  }
+
+  const dir = stat.isDirectory() ? 'd' : '-';
+  const mode = stat.mode.toString(8);
+
+  return dir + mode.slice(-3).split('').map(n => [
+    '---',
+    '--x',
+    '-w-',
+    '-wx',
+    'r--',
+    'r-x',
+    'rw-',
+    'rwx',
+  ][parseInt(n, 10)]).join('');
+};
diff --git a/node_modules/http-server/lib/core/show-dir/size-to-string.js b/node_modules/http-server/lib/core/show-dir/size-to-string.js
