+{
+	"name": "dunder-proto",
+	"version": "1.0.1",
+	"description": "If available, the `Object.prototype.__proto__` accessor and mutator, call-bound",
+	"main": false,
+	"exports": {
+		"./get": "./get.js",
+		"./set": "./set.js",
+		"./package.json": "./package.json"
+	},
