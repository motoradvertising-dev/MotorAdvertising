+            fs.stat(path.join(dir, '..'), (err, s) => {
+              if (err) {
+                if (handleError) {
+                  status[500](res, next, { error: err });
+                } else {
+                  next();
+                }
+                return;
+              }
+              dirs.unshift(['..', s]);
+              render(dirs, sortedFiles, lolwuts);
+            });
